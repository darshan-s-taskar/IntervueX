MONGO_URI=mongodb://127.0.0.1:27017/intervuex
# Generate a random secret locally; never reuse this comment as a secret.
JWT_SECRET=
GOOGLE_GENAI_API_KEY=
# Keep the original project's model; change if your Google project uses another model.
GEMINI_MODEL=gemini-3-flash-preview
PORT=3000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
# Hosting: set NODE_ENV=production, HOST=0.0.0.0, and FRONTEND_URL to the exact
# HTTPS Vercel production origin (no trailing slash). Render injects PORT.
# The Dockerfile sets these browser settings. Keep sandboxing enabled locally.
# PUPPETEER_NO_SANDBOX=true
# PUPPETEER_CACHE_DIR=/home/node/.cache/puppeteer
